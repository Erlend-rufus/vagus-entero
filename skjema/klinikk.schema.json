{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "klinikk.schema.json",
  "title": "Klinikkfakta for Vagus Entero AS",
  "description": "Alle fakta om klinikken. Ukjent = null. Bygget utelater null-felter — det gjettes aldri. Feltene org_nr, adresse, telefon/epost er lanseringskritiske (ehandelsloven § 8) og haandheves av vakter/klinikk-lansering.js i produksjonsbygg.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "juridisk_navn",
    "visningsnavn",
    "domene",
    "org_nr",
    "adresse",
    "telefon",
    "epost",
    "lege",
    "tilsyn",
    "bestilling",
    "apningstider",
    "ventetid",
    "kortnavn",
    "mva_status"
  ],
  "properties": {
    "juridisk_navn": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 2
    },
    "visningsnavn": {
      "type": [
        "string",
        "null"
      ],
      "description": "Navnet klinikken markedsfoeres under, brukt i topp og bunn. Det juridiske navnet staar i tillegg i bunnteksten (ehandelsloven § 8).",
      "minLength": 2
    },
    "kortnavn": {
      "type": [
        "string",
        "null"
      ],
      "description": "Kortformen som brukes som tittelsuffiks: «Koloskopi på Straume | Vagus Entero».",
      "minLength": 2
    },
    "domene": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z0-9.-]+\\.[a-z]{2,}$",
      "description": "Domenet slik det vises i bunnteksten. Absolutte URL-er utledes av SITE_URL, ikke av dette feltet."
    },
    "org_nr": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{9}$"
    },
    "mva_status": {
      "type": [
        "string",
        "null"
      ],
      "description": "Setningen om merverdiavgift i bunnteksten (ehandelsloven § 8). Teksten leveres av innholdsprosessen; null utelater linjen.",
      "minLength": 2
    },
    "adresse": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "gate",
        "postnummer",
        "poststed"
      ],
      "properties": {
        "gate": {
          "type": "string",
          "minLength": 2
        },
        "postnummer": {
          "type": "string",
          "pattern": "^[0-9]{4}$"
        },
        "poststed": {
          "type": "string",
          "minLength": 2
        }
      }
    },
    "telefon": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 2,
      "pattern": "^\\+?[0-9][0-9 ]{6,}$"
    },
    "epost": {
      "type": [
        "string",
        "null"
      ],
      "format": "email"
    },
    "lege": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "navn",
        "hpr_nummer"
      ],
      "properties": {
        "navn": {
          "type": "string",
          "minLength": 2
        },
        "hpr_nummer": {
          "type": "string",
          "minLength": 2
        },
        "spesialitet": {
          "type": "string"
        }
      }
    },
    "tilsyn": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "yrkestittel",
        "land",
        "tillatelse",
        "myndighet"
      ],
      "description": "Opplysningene tjenesteloven krever om regulert yrke: yrkestittel, landet tittelen er gitt i, tillatelsen med referanse, og myndigheten som har gitt den.",
      "properties": {
        "yrkestittel": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 2
        },
        "land": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 2
        },
        "tillatelse": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 2
        },
        "myndighet": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 2
        }
      }
    },
    "bestilling": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "url"
      ],
      "description": "Timebestilling hos ekstern pasientportal. Er feltet null, utelates Bestill time-knappen helt, og verten staar ikke i CSP-en. Settes url, MAA verten foeres opp i vakter/ordlister/eksterne-hvitliste.txt og i sikkerhet/policy.json — det er en bevisst beslutning, ikke en konfigurasjonsdetalj.",
      "properties": {
        "url": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https://"
        },
        "merknad": {
          "type": [
            "string",
            "null"
          ],
          "description": "Kort setning som forklarer hvor brukeren sendes. Navngir den en leverandoer, maa navnet foeres opp i vakter/ordlister/unntak/leverandorer.txt som en bevisst beslutning."
        }
      }
    },
    "apningstider": {
      "type": [
        "array",
        "null"
      ]
    },
    "ventetid": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "uker",
        "oppdatert"
      ],
      "properties": {
        "uker": {
          "type": "integer",
          "minimum": 0
        },
        "oppdatert": {
          "type": "string",
          "format": "date"
        }
      }
    }
  }
}
