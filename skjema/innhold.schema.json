          ],
          "properties": {
            "type": {
              "const": "pris"
            },
            "tittel": {
              "type": "string",
              "minLength": 3,
              "maxLength": 80
            },
            "under": {
              "type": "string",
              "minLength": 10,
              "maxLength": 400
            },
            "flate": {
              "enum": [
                "krem",
                "sand"
              ]
            },
            "avsnitt": {
              "$ref": "#/$defs/avsnitt"
            },
            "knapper": {
              "type": "array",
              "minItems": 1,
              "maxItems": 2,
              "items": {
                "$ref": "#/$defs/knapp"
              }
            },
            "priser": {
              "type": "array",
              "minItems": 1,
              "maxItems": 12,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
