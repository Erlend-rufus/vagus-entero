                    "type": "string",
                    "minLength": 2,
                    "maxLength": 80
                  },
                  "belop_nok": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "exclusiveMinimum": 0
                  },
                  "merknad": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 200
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
