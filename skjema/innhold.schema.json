{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "innhold.schema.json",
  "title": "Innholdskontrakt v1 for Vagus Entero AS",
  "description": "Frontmatter-skjema for filer i src/innhold/. Manglende obligatorisk felt skal feile bygget. Ingen standardverdier.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sidetype",
    "url",
    "malgruppe",
    "tittel",
    "meta_beskrivelse",
    "status",
    "godkjent_av",
    "godkjent_dato",
    "jsonld_type",
    "interne_lenker_ut",
    "apne_punkter",
    "i_navigasjon",
    "rekkefolge",
    "i_bunntekst"
  ],
  "properties": {
    "sidetype": {
      "enum": [
        "forside",
        "undersokelse",
        "tilstand",
        "behandling",
        "pris",
        "henviser",
        "forsikring",
        "statisk"
      ]
    },
    "url": {
      "type": "string",
      "pattern": "^/([a-z0-9-]+/)*$"
    },
    "malgruppe": {
      "enum": [
        "selvbetalende",
        "henviser",
        "forsikring"
      ]
    },
    "tittel": {
      "type": "string",
      "minLength": 10,
      "maxLength": 60
    },
    "meta_beskrivelse": {
      "type": "string",
      "minLength": 70,
      "maxLength": 155
    },
    "status": {
      "enum": [
        "UTKAST",
        "KLAR_FOR_MEDISINSK_GJENNOMGANG",
        "GODKJENT"
      ]
    },
    "godkjent_av": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 2
    },
    "godkjent_dato": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "jsonld_type": {
      "enum": [
        "MedicalProcedure",
        "MedicalClinic",
        "Physician",
        null
      ]
    },
    "interne_lenker_ut": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^/([a-z0-9-]+/)*$"
      }
    },
    "apne_punkter": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "i_navigasjon": {
      "type": "boolean"
    },
    "rekkefolge": {
      "type": "integer",
      "minimum": 0
    },
    "sist_oppdatert": {
      "type": "string",
      "format": "date"
    },
    "ingress": {
      "type": "string",
      "minLength": 30,
      "maxLength": 300
    },
    "bilder": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fil",
          "alt"
        ],
        "properties": {
          "fil": {
            "type": "string",
            "minLength": 1
          },
          "alt": {
            "type": "string"
          },
          "bildetekst": {
            "type": "string"
          },
          "dekorativt": {
            "type": "boolean"
          }
        }
      }
    },
    "priser": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "navn",
          "belop_nok"
        ],
        "properties": {
          "navn": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "belop_nok": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "merknad": {
            "type": "string"
          }
        }
      }
    },
    "illustrasjon": {
      "$ref": "#/$defs/illustrasjonsnavn"
    },
    "hode_knapper": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/knapp"
      }
    },
    "fakta": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "term",
          "verdi"
        ],
        "properties": {
          "term": {
            "type": "string",
            "minLength": 3,
            "maxLength": 40
          },
          "verdi": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        }
      }
    },
    "seksjoner": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/blokk"
      }
    },
    "overordnet": {
      "type": "string",
      "pattern": "^/[a-z0-9/-]*$"
    },
    "menytittel": {
      "type": "string",
      "minLength": 3,
      "maxLength": 30
    },
    "i_bunntekst": {
      "type": "boolean"
    }
  },
  "$defs": {
    "avsnitt": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 900
      }
    },
    "knapp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tekst",
        "handling"
      ],
      "properties": {
        "tekst": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "handling": {
          "enum": [
            "bestilling",
            "telefon",
            "intern"
          ]
        },
        "url": {
          "type": "string",
          "pattern": "^/[a-z0-9/-]*$"
        },
        "stil": {
          "enum": [
            "primaer",
            "sekundaer",
            "invers"
          ]
        }
      }
    },
    "blokk_felles": {
      "tittel": {
        "type": "string",
        "minLength": 3,
        "maxLength": 80
      },
      "under": {
        "type": "string",
        "minLength": 10,
        "maxLength": 400
      },
      "flate": {
        "enum": [
          "krem",
          "sand"
        ]
      }
    },
    "blokk": {
      "type": "object",
      "discriminator": {
        "propertyName": "type"
      },
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string"
        }
      },
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "tittel",
            "avsnitt"
          ],
          "properties": {
            "type": {
              "const": "tekst"
            },
            "tittel": {
              "type": "string",
              "minLength": 3,
              "maxLength": 80
            },
            "under": {
              "type": "string",
              "minLength": 10,
              "maxLength": 400
            },
            "flate": {
              "enum": [
                "krem",
                "sand"
              ]
            },
            "avsnitt": {
              "$ref": "#/$defs/avsnitt"
            },
            "merknad": {
              "type": "string",
              "minLength": 3,
              "maxLength": 400
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "tittel",
            "punkter"
          ],
          "properties": {
            "type": {
              "const": "tidslinje"
            },
            "tittel": {
              "type": "string",
              "minLength": 3,
              "maxLength": 80
            },
            "under": {
              "type": "string",
              "minLength": 10,
              "maxLength": 400
            },
            "flate": {
              "enum": [
                "krem",
                "sand"
              ]
            },
            "eksempelmerknad": {
              "type": "string",
              "minLength": 20,
              "maxLength": 400
            },
            "punkter": {
              "type": "array",
              "minItems": 2,
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "naar",
                  "tekst"
                ],
                "properties": {
                  "naar": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 40
                  },
                  "tekst": {
                    "type": "string",
                    "minLength": 20,
                    "maxLength": 600
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "tittel",
            "steg"
          ],
          "properties": {
            "type": {
              "const": "steg"
            },
            "tittel": {
              "type": "string",
              "minLength": 3,
              "maxLength": 80
            },
            "under": {
              "type": "string",
              "minLength": 10,
              "maxLength": 400
            },
            "flate": {
              "enum": [
                "krem",
                "sand"
              ]
            },
            "strek": {
              "type": "boolean"
            },
            "steg": {
              "type": "array",
              "minItems": 2,
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "tittel",
                  "tekst"
                ],
                "properties": {
                  "tittel": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 60
                  },
                  "tekst": {
                    "type": "string",
                    "minLength": 15,
                    "maxLength": 400
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "tittel",
            "sporsmal"
          ],
          "properties": {
            "type": {
              "const": "sporsmal"
            },
            "tittel": {
              "type": "string",
              "minLength": 3,
              "maxLength": 80
            },
            "under": {
              "type": "string",
              "minLength": 10,
              "maxLength": 400
            },
            "flate": {
              "enum": [
                "krem",
                "sand"
              ]
            },
            "sporsmal": {
              "type": "array",
              "minItems": 2,
              "maxItems": 14,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "sporsmal",
                  "svar"
                ],
                "properties": {
                  "sporsmal": {
                    "type": "string",
                    "minLength": 5,
                    "maxLength": 90
                  },
                  "svar": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 900
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "tittel",
            "veier"
          ],
          "properties": {
            "type": {
              "const": "veier"
            },
            "tittel": {
              "type": "string",
              "minLength": 3,
              "maxLength": 80
            },
            "under": {
              "type": "string",
              "minLength": 10,
              "maxLength": 400
            },
            "flate": {
              "enum": [
                "krem",
                "sand"
              ]
            },
            "veier": {
              "type": "array",
              "minItems": 2,
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "tittel",
                  "avsnitt"
                ],
                "properties": {
                  "tittel": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 60
                  },
                  "avsnitt": {
                    "$ref": "#/$defs/avsnitt"
                  },
                  "liten": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 300
                  },
                  "knapp": {
                    "$ref": "#/$defs/knapp"
                  },
                  "illustrasjon": {
                    "$ref": "#/$defs/illustrasjonsnavn"
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "tittel",
            "punkter"
          ],
          "properties": {
            "type": {
              "const": "praktisk"
            },
            "tittel": {
              "type": "string",
              "minLength": 3,
              "maxLength": 80
            },
            "under": {
              "type": "string",
              "minLength": 10,
              "maxLength": 400
            },
            "flate": {
              "enum": [
                "krem",
                "sand"
              ]
            },
            "punkter": {
              "type": "array",
              "minItems": 2,
              "maxItems": 6,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "tittel",
                  "tekst"
                ],
                "properties": {
                  "tittel": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 60
                  },
                  "tekst": {
                    "type": "string",
                    "minLength": 15,
                    "maxLength": 400
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "tittel",
            "kort"
          ],
          "properties": {
            "type": {
              "const": "kort"
            },
            "tittel": {
              "type": "string",
              "minLength": 3,
              "maxLength": 80
            },
            "under": {
              "type": "string",
              "minLength": 10,
              "maxLength": 400
            },
            "flate": {
              "enum": [
                "krem",
                "sand"
              ]
            },
            "kort": {
              "type": "array",
              "minItems": 2,
              "maxItems": 6,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "tittel"
                ],
                "properties": {
                  "tittel": {
                    "type": "string",
                    "minLength": 5,
                    "maxLength": 80
                  },
                  "fagterm": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 60
                  },
                  "illustrasjon": {
                    "$ref": "#/$defs/illustrasjonsnavn"
                  },
                  "url": {
                    "type": "string",
                    "pattern": "^/[a-z0-9/-]*$"
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "tittel",
            "avsnitt"
          ],
          "properties": {
            "type": {
              "const": "kort_bred"
            },
            "tittel": {
              "type": "string",
              "minLength": 3,
              "maxLength": 80
            },
            "under": {
              "type": "string",
              "minLength": 10,
              "maxLength": 400
            },
            "flate": {
              "enum": [
                "krem",
                "sand"
              ]
            },
            "avsnitt": {
              "$ref": "#/$defs/avsnitt"
            },
            "illustrasjon": {
              "$ref": "#/$defs/illustrasjonsnavn"
            },
            "knapp": {
              "$ref": "#/$defs/knapp"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "tittel",
