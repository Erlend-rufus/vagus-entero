            },
            "tittel": {
              "type": "string",
              "minLength": 3,
              "maxLength": 80
            },
            "under": {
              "type": "string",
              "minLength": 10,
              "maxLength": 400
            },
            "flate": {
              "enum": [
                "krem",
                "sand"
              ]
            },
            "priser": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "navn",
                  "belop_nok"
                ],
                "properties": {
                  "navn": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 120
                  },
                  "belop_nok": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "exclusiveMinimum": 0
                  },
                  "merknad": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 200
                  }
                }
              }
            }
          }
        }
