<!doctype html>
<html lang="nb">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ sidetittel or tittel }} | {{ klinikk.kortnavn or klinikk.juridisk_navn }}</title>
  <meta name="description" content="{{ meta_beskrivelse }}">
  {%- if miljo.noindex or noindex %}
  <meta name="robots" content="noindex, nofollow">
  {%- endif %}
  {%- if miljo.produksjon and miljo.siteUrl %}
  <link rel="canonical" href="{{ miljo.siteUrl }}{{ page.url }}">
  {%- endif %}
  <link rel="icon" href="/bilder/favicon.svg" type="image/svg+xml">
  <link rel="preload" href="/fonter/work-sans-norsk.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonter/eb-garamond-norsk.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="{{ stilSti }}">
</head>
<body>
  <a class="hopp-lenke" href="#innhold">{{ ui.hopp_til_innhold }}</a>
  {%- if status and status != 'GODKJENT' %}
  {% include "komponenter/utkast-banner.njk" %}
  {%- endif %}
  {% include "komponenter/header.njk" %}
  <main id="innhold">
{{ content | safe }}
  </main>
  {% include "komponenter/footer.njk" %}
</body>
</html>
