<!doctype html>
<html lang="nb">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ tittel }} – {{ klinikk.juridisk_navn }}</title>
  <meta name="description" content="{{ meta_beskrivelse }}">
  {%- if miljo.noindex %}
  <meta name="robots" content="noindex, nofollow">
  {%- endif %}
  {%- if miljo.produksjon and miljo.siteUrl %}
  <link rel="canonical" href="{{ miljo.siteUrl }}{{ page.url }}">
  {%- endif %}
  <link rel="preload" href="/fonter/source-sans-3-norsk.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/stiler/hoved.css">
</head>
<body>
  <a class="hopp-lenke" href="#innhold">{{ ui.hopp_til_innhold }}</a>
  {%- if status and status != 'GODKJENT' %}
  {% include "komponenter/utkast-banner.njk" %}
  {%- endif %}
  {%- if not skjul_ramme %}
  {% include "komponenter/header.njk" %}
  {%- endif %}
  <main id="innhold">
{{ content | safe }}
  </main>
  {%- if not skjul_ramme %}
  {% include "komponenter/footer.njk" %}
  {%- endif %}
</body>
</html>
