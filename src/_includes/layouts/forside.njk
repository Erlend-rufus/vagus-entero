---
layout: layouts/base.njk
---
<article class="forside">
  <header class="hero">
    <h1>{{ tittel }}</h1>
    {%- if ingress %}
    <p class="ingress">{{ ingress }}</p>
    {%- endif %}
    {%- if klinikk.telefon %}
    <p class="hero-handlinger">
      <a class="knapp" href="tel:{{ klinikk.telefon | replace(' ', '') }}">{{ klinikk.telefon }}</a>
    </p>
    {%- endif %}
  </header>

  <div class="forside-innhold">
{{ content | safe }}
  </div>

  {%- set undersokelser = collections.innhold | sidetype('undersokelse') %}
  {%- if undersokelser.length > 0 and undersokelser_tittel %}
  <section class="forside-seksjon">
    <h2>{{ undersokelser_tittel }}</h2>
    <ul class="kortliste">
      {%- for side in undersokelser %}
      <li class="kort">
        <h3><a href="{{ side.url }}">{{ side.data.tittel }}</a></h3>
        <p>{{ side.data.meta_beskrivelse }}</p>
      </li>
      {%- endfor %}
    </ul>
  </section>
  {%- endif %}
</article>
{% include "komponenter/jsonld.njk" %}
