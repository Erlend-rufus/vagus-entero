<footer class="bunn" aria-label="{{ ui.bunntekst }}">
  <div class="bunn-indre">
    <div class="bunn-fakta">
      {%- if klinikk.juridisk_navn %}
      <p class="bunn-navn">{{ klinikk.juridisk_navn }}{% if klinikk.org_nr %} · {{ klinikk.org_nr }}{% endif %}</p>
      {%- endif %}
      {%- if klinikk.adresse %}
      <p>{{ klinikk.adresse.gate }}, {{ klinikk.adresse.postnummer }} {{ klinikk.adresse.poststed }}</p>
      {%- endif %}
      {%- if klinikk.telefon %}
      <p><a href="tel:{{ klinikk.telefon | replace(' ', '') }}">{{ klinikk.telefon }}</a></p>
      {%- endif %}
      {%- if klinikk.epost %}
      <p><a href="mailto:{{ klinikk.epost }}">{{ klinikk.epost }}</a></p>
      {%- endif %}
    </div>
    {%- if collections.bunn.length > 0 %}
    <ul class="bunn-lenker">
      {%- for side in collections.bunn %}
      <li><a href="{{ side.url }}">{{ side.data.tittel }}</a></li>
      {%- endfor %}
    </ul>
    {%- endif %}
    <p class="til-toppen"><a href="#innhold">{{ ui.til_toppen }}</a></p>
  </div>
</footer>
