{%- from "komponenter/knapper.njk" import knapp, knapperad -%}
{%- from "komponenter/illustrasjon.njk" import merke -%}

{#- Én gren per blokktype i innholdskontrakten. Blokkene kommer ferdig
    validert fra bygget, så malene trenger ingen fallback — mangler noe,
    har bygget allerede stoppet. Alt rendres inline: en {% include %} inne i
    en makro ser ikke makroens egne variabler.

    Prosa går gjennom filteret «tekst»: det escaper alt, gjør [tekst](/url/)
    til intern lenke og linjeskift til <br>. Ingen annen HTML slipper inn. -#}

{#- Pristabellen brukes to steder: som egen seksjon (prisliste, med caption
    og kolonnehoder) og kompakt inne i prisblokken. Rader uten beløp vises
    aldri med beløp — finnes ingen beløp, faller beløpskolonnen bort og
    tabellen viser bare tjenestene. -#}
{%- macro pristabell(priser, kolonner, tabellmerknad, klasse) -%}
  {%- set medBelop = priser | medBelop -%}
  {%- set visBelop = medBelop.length > 0 -%}
  {%- set rader = medBelop if visBelop else priser -%}
  <table class="pristabell{{ (' ' + klasse) if klasse else '' }}">
    {%- if tabellmerknad and visBelop %}
    <caption>{{ tabellmerknad | tekst | safe }}</caption>
    {%- endif %}
    {%- if kolonner %}
    <thead><tr><th scope="col">{{ kolonner.tjeneste }}</th><th scope="col">{{ kolonner.omfang }}</th>{% if visBelop %}<th scope="col" class="pris-belop">{{ kolonner.pris }}</th>{% endif %}</tr></thead>
    {%- endif %}
    <tbody>
      {%- for rad in rader %}
      <tr><th scope="row">{{ rad.navn }}{% if rad.merknad %} <span class="pris-merknad">({{ rad.merknad }})</span>{% endif %}</th>{% if kolonner %}<td class="pris-omfang">{{ rad.omfang if rad.omfang else '' }}</td>{% endif %}{% if visBelop %}<td class="pris-belop">{{ rad.belop_nok | kroner }}</td>{% endif %}</tr>
      {%- endfor %}
    </tbody>
  </table>
{%- endmacro -%}

{%- macro seksjoner(blokker, klinikk, sider, ui) -%}
  {%- for blokk in blokker %}
  {%- if blokk.type == 'pris' %}
  {%- set medBelop = (blokk.priser | medBelop) if blokk.priser else [] %}
  {%- set harSide = blokk.sidekolonne or medBelop.length > 0 %}
  <section class="{{ 'flate-sand' if blokk.flate == 'sand' else '' }}">
    <div class="seksjon-indre">
      <div class="prisblokk{{ '' if harSide else ' prisblokk-enkel' }}">
        <div class="prisblokk-tekst">
          <h2>{{ blokk.tittel }}</h2>
          {%- for avsnitt in blokk.avsnitt %}
          <p>{{ avsnitt | tekst | safe }}</p>
          {%- endfor %}
          {%- if blokk.knapper %}{{ knapperad(blokk.knapper, klinikk, sider, 'prisblokk-handlinger', true, ui) }}{% endif %}
        </div>
        {%- if blokk.sidekolonne %}
        <div class="prisblokk-side">
          <p class="prisblokk-etikett">{{ blokk.sidekolonne.etikett }}</p>
          {%- for avsnitt in blokk.sidekolonne.avsnitt %}
          <p>{{ avsnitt | tekst | safe }}</p>
          {%- endfor %}
        </div>
        {%- elif medBelop.length > 0 %}
        {{ pristabell(blokk.priser, null, null, 'pristabell-kompakt') }}
        {%- endif %}
      </div>
    </div>
  </section>
  {%- else %}
  <section class="{{ 'flate-sand' if blokk.flate == 'sand' else '' }}">
    <div class="seksjon-indre sek">
      {#- kort_bred uten «under» er forsidens mønster: overskriften står inne i
          kortet. Med «under» står overskrift og undertekst over kortet. -#}
      {%- if blokk.type != 'kort_bred' or blokk.under %}
      <h2>{{ blokk.tittel }}</h2>
      {%- endif %}
      {%- if blokk.under %}
      <p class="under">{{ blokk.under | tekst | safe }}</p>
      {%- endif %}

      {%- if blokk.type == 'tekst' %}
        {%- for avsnitt in blokk.avsnitt %}
        <p>{{ avsnitt | tekst | safe }}</p>
        {%- endfor %}
        {%- if blokk.merknad %}
        <p class="merknad">{{ blokk.merknad | tekst | safe }}</p>
        {%- endif %}

      {%- elif blokk.type == 'tidslinje' %}
        {%- if blokk.eksempelmerknad %}
        <p class="eksempel">{{ blokk.eksempelmerknad | tekst | safe }}</p>
        {%- endif %}
        <ol class="tidslinje">
          {%- for punkt in blokk.punkter %}
          <li><span class="naar">{{ punkt.naar }}</span><p>{{ punkt.tekst | tekst | safe }}</p></li>
          {%- endfor %}
        </ol>
        {%- if blokk.etter %}
        <p class="tidslinje-etter">{{ blokk.etter | tekst | safe }}</p>
        {%- endif %}

      {%- elif blokk.type == 'steg' %}
        {%- if blokk.strek %}
        <svg class="stegstrek" viewBox="0 0 1296 46" preserveAspectRatio="none" fill="none" stroke="#0c444b" stroke-width="2.5" aria-hidden="true" focusable="false"><path d="M0 30 C 140 30 160 12 216 12 C 280 12 300 34 432 34 C 560 34 580 14 648 14 C 720 14 740 34 864 34 C 990 34 1010 12 1080 12 C 1180 12 1240 28 1296 28"/><circle cx="216" cy="12" r="7" fill="#b96a4b"/><circle cx="648" cy="14" r="7" fill="#b96a4b"/><circle cx="1080" cy="12" r="7" fill="#b96a4b"/></svg>
        {%- endif %}
        <ol class="steg">
          {%- for steg in blokk.steg %}
          <li><span class="steg-nr" aria-hidden="true">{{ loop.index }}</span><h3>{{ steg.tittel }}</h3><p>{{ steg.tekst | tekst | safe }}</p></li>
          {%- endfor %}
        </ol>

      {%- elif blokk.type == 'sporsmal' %}
        <div class="sporsmal">
          {%- for par in blokk.sporsmal %}
          <details><summary>{{ par.sporsmal }}</summary><div class="svar"><p>{{ par.svar | tekst | safe }}</p></div></details>
          {%- endfor %}
        </div>

      {%- elif blokk.type == 'veier' %}
        <ul class="veier">
          {%- for vei in blokk.veier %}
          <li class="vei">
            {%- if vei.illustrasjon %}{{ merke(vei.illustrasjon, 'vei-illustrasjon', 72) }}{% endif %}
            <h3>{{ vei.tittel }}</h3>
            {%- if vei.undertittel %}
            <p class="liten undertittel">{{ vei.undertittel | tekst | safe }}</p>
            {%- endif %}
            {%- for avsnitt in vei.avsnitt %}
            <p>{{ avsnitt | tekst | safe }}</p>
            {%- endfor %}
            {%- if vei.liten %}
            <p class="liten">{{ vei.liten | tekst | safe }}</p>
            {%- endif %}
            {%- if vei.knapp %}{{ knapp(vei.knapp, klinikk, sider, false, ui) }}{% endif %}
          </li>
          {%- endfor %}
        </ul>

      {%- elif blokk.type == 'praktisk' %}
        <ul class="praktisk">
          {%- for punkt in blokk.punkter %}
          <li><h3>{{ punkt.tittel }}</h3><p>{{ punkt.tekst | tekst | safe }}</p></li>
          {%- endfor %}
        </ul>
        {%- if blokk.merknad %}
        <p class="merknad">{{ blokk.merknad | tekst | safe }}</p>
        {%- endif %}

      {%- elif blokk.type == 'kort' %}
        <ul class="kortliste">
          {%- for kort in blokk.kort %}
          <li>
            {%- if kort.url and (sider | finnesUrl(kort.url)) %}
            <a class="kort" href="{{ kort.url }}">
              {%- if kort.illustrasjon %}{{ merke(kort.illustrasjon, 'kort-illustrasjon', 46) }}{% endif %}
              <span><span class="kort-tittel">{{ kort.tittel }}</span>{% if kort.fagterm %}<span class="kort-fagterm">{{ kort.fagterm }}</span>{% endif %}</span>
              <span class="kort-les">{{ ui.les_mer }}</span>
            </a>
            {%- else %}
            <div class="kort">
              {%- if kort.illustrasjon %}{{ merke(kort.illustrasjon, 'kort-illustrasjon', 46) }}{% endif %}
              <span><span class="kort-tittel">{{ kort.tittel }}</span>{% if kort.fagterm %}<span class="kort-fagterm">{{ kort.fagterm }}</span>{% endif %}</span>
            </div>
            {%- endif %}
          </li>
          {%- endfor %}
        </ul>

      {%- elif blokk.type == 'kort_bred' %}
        <div class="kort-bred{{ '' if blokk.illustrasjon else ' kort-bred-enkel' }}">
          {%- if blokk.illustrasjon %}{{ merke(blokk.illustrasjon, '', 96) }}{% endif %}
          <div>
            {%- if not blokk.under %}
            <h2>{{ blokk.tittel }}</h2>
            {%- endif %}
            {%- for avsnitt in blokk.avsnitt %}
            <p>{{ avsnitt | tekst | safe }}</p>
            {%- endfor %}
          </div>
          {%- if blokk.knapp %}{{ knapp(blokk.knapp, klinikk, sider, false, ui) }}{% endif %}
        </div>

      {%- elif blokk.type == 'prisliste' %}
        {{ pristabell(blokk.priser, blokk.kolonner if blokk.kolonner else null, blokk.tabellmerknad if blokk.tabellmerknad else null, '') }}
        {%- if blokk.merknad %}
        <p class="merknad">{{ blokk.merknad | tekst | safe }}</p>
        {%- endif %}
      {%- endif %}
    </div>
  </section>
  {%- endif %}
  {%- endfor -%}
{%- endmacro -%}
