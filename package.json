  },
  "dependencies": {
    "@11ty/eleventy": "3.1.6",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "gray-matter": "4.0.3"
  },
  "devDependencies": {
    "@lhci/cli": "0.15.1",
    "pa11y-ci": "4.1.1"
  }
}
