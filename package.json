{
  "name": "vagus-entero-nettside",
  "version": "0.1.0",
  "private": true,
  "description": "Statisk nettsted for Vagus Entero AS",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "bygg": "eleventy && node vakter/kjor-alle.js --dist",
    "bygg:ren": "eleventy",
