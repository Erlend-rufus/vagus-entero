{
  "name": "vagus-entero-nettside",
  "version": "0.1.0",
  "private": true,
  "description": "Statisk nettsted for Vagus Entero AS",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "bygg": "eleventy && node vakter/kjor-alle.js --dist",
    "bygg:ren": "eleventy",
    "server": "eleventy --serve",
    "vakter": "node vakter/kjor-alle.js",
    "test": "node vakter/tester/kjor-selvtester.js",
    "test:a11y": "node verktoy/a11y-test.mjs",
    "subsett-font": "python3 verktoy/subsett-font.py"
  },
  "dependencies": {
    "@11ty/eleventy": "3.1.6",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "gray-matter": "4.0.3",
    "parse5": "8.0.0"
  },
  "devDependencies": {
    "@lhci/cli": "0.15.1",
    "axe-core": "4.13.0",
    "puppeteer-core": "24.43.1"
  }
}
